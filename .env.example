# Returns Manager configuration (build prompt §5). Copy to `.env` (git-ignored) and fill in the blanks.
# Every variable is validated at start-up; secrets are never logged. Defaults shown are the prompt's.

# ── Gemini (free tier) ────────────────────────────────────
# from Google AI Studio (aistudio.google.com → Get API key); secret
GEMINI_API_KEY=
# gemini | replay (tests)
RM_MODEL_PROVIDER=gemini
RM_JUDGMENT_MODEL=gemini-3.8-flash
# low|medium|high; swept in eval; change only on measured evidence
RM_JUDGMENT_THINKING=medium
# only when the judgment quota is exhausted; never mixed within one eval run
RM_JUDGMENT_FALLBACK_MODEL=gemini-3-flash-preview
# per-inspection budget (submit → decision ready); measured in P5
RM_TARGET_P95_LATENCY_S=45
# PAID-EQUIVALENT per-inspection budget (actual spend is $0 on the free tier)
RM_TARGET_MEAN_COST_USD=0.01
# same model, deeper settings (no free Pro model)
RM_ESCALATION_MODEL=gemini-3.8-flash
RM_ESCALATION_THINKING=high
# a different free model = a meaningful second opinion
RM_AUDIT_MODEL=gemini-3.6-flash
RM_AUDIT_THINKING=medium
# 0 in normal operation on the free tier; 1.0 during eval runs
RM_AUDIT_SAMPLE_RATE=0.0
RM_EXPLAINER_MODEL=gemini-3.1-flash-lite
RM_EXPLAINER_THINKING=low
# Daily request budgets (requests per day per model). Set from the REAL AI Studio numbers; keep ~10% headroom.
RM_DAILY_REQUEST_BUDGET_JUDGMENT=18
RM_DAILY_REQUEST_BUDGET_AUDIT=18
RM_DAILY_REQUEST_BUDGET_EXPLAINER=50
# requests per minute ceiling for the client-side limiter
RM_RPM_LIMIT_JUDGMENT=8
# RPD resets at midnight Pacific
RM_QUOTA_RESET_TZ=America/Los_Angeles
# json_schema | json_prompted (fallback if the schema is rejected)
RM_OUTPUT_MODE=json_schema
RM_MAX_OUTPUT_TOKENS=16000
# total requests per session, incl. the first (free-tier default)
RM_MAX_ROUND_TRIPS=2
# escalation: 6
RM_MAX_CROPS_PER_SESSION=4
RM_MODEL_TIMEOUT_S=180
# low|medium|high (Gemini per-image token budget: 280|560|1120)
RM_RETURN_PHOTO_RESOLUTION=high
RM_REFERENCE_PHOTO_RESOLUTION=medium
# 2240 tokens per crop; crops are small regions of the original
RM_CROP_RESOLUTION=ultra_high
# resize before upload (bandwidth); token cost is set by the resolution above
RM_ANALYSIS_LONG_EDGE=1568
RM_CROP_MAX_EDGE=1568
# upload reference images once and reuse the URI
RM_USE_FILES_API_FOR_REFERENCES=true
# needed for previous_interaction_id chaining in tool round trips
RM_INTERACTION_STORE=true

# ── Database / Supabase ───────────────────────────────────
# role rm_app_login ONLY (non-bypass); session mode or direct connection
DATABASE_URL=
# owner role; used ONLY by `returns-manager db migrate`
DATABASE_MIGRATOR_URL=
# local: http://127.0.0.1:54321
SUPABASE_URL=
# frontend only (Part 2)
SUPABASE_ANON_KEY=
# storage module ONLY; never for table queries; never sent to a browser
SUPABASE_SERVICE_ROLE_KEY=
# verify the exact URL for the project (local: <SUPABASE_URL>/auth/v1/.well-known/jwks.json)
SUPABASE_JWKS_URL=
# local: <SUPABASE_URL>/auth/v1
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# ONLY if the project still signs JWTs with the legacy HS256 secret
SUPABASE_JWT_SECRET=
RM_STORAGE_BUCKET_PHOTOS=rm-return-photos
RM_STORAGE_BUCKET_REFERENCE=rm-reference
RM_SIGNED_URL_TTL_S=300

# ── Behaviour ─────────────────────────────────────────────
# local | test | demo
RM_ENV=local
RM_TARGET_MARKETPLACE=amazon.in
RM_WORKER_CONCURRENCY=6
RM_MAX_INFLIGHT_PER_ORG=4
RM_JOB_MAX_ATTEMPTS=5
RM_JOB_LEASE_S=600
RM_CIRCUIT_FAILURE_THRESHOLD=5
RM_CIRCUIT_COOLDOWN_S=60
# ₹5,000 in paise; configurable per org
RM_HIGH_VALUE_THRESHOLD_MINOR=500000
# free tier: any paid spend is refused unless a human raises this
RM_MAX_DAILY_SPEND_USD=0
# raise only if the human enables billing for the eval run
RM_EVAL_SPEND_CAP_USD=0
# comma-separated hostnames (later phase)
RM_WEBHOOK_ALLOWLIST=
LOG_LEVEL=info
