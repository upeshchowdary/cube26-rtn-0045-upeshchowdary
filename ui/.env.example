# Copy to .env (git-ignored) for local development.

# The Returns Manager API base URL. Default matches `returns-manager api serve` defaults.
VITE_API_BASE_URL=http://127.0.0.1:8000

# A real API key minted via the backend CLI, used to pre-fill the Connect screen:
#   cd agent && uv run returns-manager keys create --org org_demo_alpha --scope admin --name ui-dev
# Leave blank to type/paste the key by hand in the Connect screen instead.
VITE_API_KEY=
